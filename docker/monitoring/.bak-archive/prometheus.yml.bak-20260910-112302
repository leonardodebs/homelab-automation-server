global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/restic-alerts.yml
  - /etc/prometheus/dell-node-alerts.yml
  - /etc/prometheus/homelab-node-alerts.yml
  - /etc/prometheus/openclaw-alerts.yml
  - /etc/prometheus/jobops-alerts.yml
  - /etc/prometheus/watchdog-alerts.yml
  - /etc/prometheus/k3s-alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

scrape_configs:
  # O próprio Prometheus
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Métricas do servidor (CPU, RAM, disco, rede)
  - job_name: 'node'
    static_configs:
      - targets: ['node-exporter:9100']

  # Métricas dos containers Docker
  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']

  # Métricas do PostgreSQL do n8n
  - job_name: 'postgres'
    static_configs:
      - targets: ['postgres-exporter:9187']

  # Metricas do repositorio Restic no Dell.
  - job_name: 'restic'
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
      - targets: ['192.168.15.2:8001']
        labels:
          instance: homelab-dell
          site: homelab

  # Metricas do host Dell (CPU, RAM, disco, uptime e rede).
  - job_name: 'node-dell'
    scrape_interval: 15s
    scrape_timeout: 10s
    static_configs:
      - targets: ['192.168.15.2:9100']
        labels:
          instance: homelab-dell
          server: dell
          site: homelab

  # Metricas dos containers Docker do Dell.
  - job_name: 'cadvisor-dell'
    scrape_interval: 15s
    scrape_timeout: 10s
    static_configs:
      - targets: ['192.168.15.2:8081']
        labels:
          instance: homelab-dell
          server: dell
          site: homelab

  # Metricas de dominio do JobOps Agent
  - job_name: 'jobops'
    scrape_interval: 60s
    scrape_timeout: 20s
    metrics_path: /metrics
    static_configs:
      - targets: ['192.168.15.3:30800']
        labels:
          instance: jobops-api
          server: lenovo
          site: homelab

  # Estado dos objetos do cluster k3s: pods, replicas, PVC, jobs e nos.
  # O cAdvisor do Docker nao enxerga esses pods, porque o k3s usa containerd.
  - job_name: 'k3s-state'
    scrape_interval: 30s
    static_configs:
      - targets: ['192.168.15.3:30080']
        labels:
          instance: k3s-lenovo
          server: lenovo
          site: homelab

  # Metricas do kubelet (volumes, pods rodando, latencia do runtime) e, no job
  # seguinte, CPU/memoria por pod via cAdvisor embutido.
  #
  # Ambos vao pela NodePort 30081 e nao direto na 10250: as regras de firewall
  # que o k3s instala bloqueiam a porta do kubelet para as sub-redes bridge do
  # Docker, e este Prometheus e um container. Um proxy dentro do cluster faz a
  # ponte, porque um pod alcanca o kubelet normalmente.
  # Manifesto: my-finance-hub/k8s/monitoring/kubelet-metrics-proxy.yaml
  #
  # O token continua obrigatorio: o proxy so repassa o header Authorization e
  # quem autentica e o proprio kubelet.
  - job_name: 'k3s-kubelet'
    scrape_interval: 30s
    bearer_token_file: /etc/prometheus/k3s-token
    static_configs:
      - targets: ['192.168.15.3:30081']
        labels:
          instance: k3s-lenovo
          server: lenovo
          site: homelab

  - job_name: 'k3s-cadvisor'
    metrics_path: /metrics/cadvisor
    scrape_interval: 30s
    bearer_token_file: /etc/prometheus/k3s-token
    static_configs:
      - targets: ['192.168.15.3:30081']
        labels:
          instance: k3s-lenovo
          server: lenovo
          site: homelab
    metric_relabel_configs:
      # id, image e name trazem caminho de cgroup e sha256 completos. Sao
      # inuteis para consulta e multiplicam a cardinalidade a cada deploy,
      # porque a tag da imagem muda toda vez.
      - action: labeldrop
        regex: 'id|image|name'
      # Series sem container sao o sandbox do pod, ruido puro aqui.
      - source_labels: [container]
        regex: '^$'
        action: drop

  # Metricas de dominio do my-finance-hub (latencia por rota, importacoes).
  - job_name: 'finance-app'
    scrape_interval: 30s
    metrics_path: /api/metrics
    static_configs:
      - targets: ['192.168.15.3:80']
        labels:
          instance: finance-api
          server: lenovo
          site: homelab
