services:
  prometheus:
    image: prom/prometheus:v3.13.2
    container_name: prometheus
    restart: always
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.retention.time=15d'
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/restic-alerts.yml:/etc/prometheus/restic-alerts.yml:ro
      - ./prometheus/dell-node-alerts.yml:/etc/prometheus/dell-node-alerts.yml:ro
      - ./prometheus/homelab-node-alerts.yml:/etc/prometheus/homelab-node-alerts.yml:ro
      - ./prometheus/openclaw-alerts.yml:/etc/prometheus/openclaw-alerts.yml:ro
      - ./prometheus/jobops-alerts.yml:/etc/prometheus/jobops-alerts.yml:ro
      - prometheus_data:/prometheus
    ports:
      - "192.168.15.3:9090:9090"
    networks:
      - monitoring
    depends_on:
      - alertmanager
  alertmanager:
    image: prom/alertmanager:v0.33.1
    container_name: alertmanager
    restart: unless-stopped
    user: "1000:1000"
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - ./alertmanager/templates:/etc/alertmanager/templates:ro
      - /home/leonardo/.config/homelab-alerts/gmail-app-password:/run/secrets/gmail_app_password:ro
      - /home/leonardo/.local/share/homelab-alertmanager:/alertmanager
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    networks:
      - monitoring
  grafana:
    image: grafana/grafana:13.1.3
    container_name: grafana
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD}
      GF_USERS_ALLOW_SIGN_UP: "false"
      INFLUXDB_USER_PASSWORD: ${INFLUXDB_USER_PASSWORD}
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana_data:/var/lib/grafana
    ports:
      - "192.168.15.3:3000:3000"
    depends_on:
      - prometheus
    networks:
      - monitoring
  node-exporter:
    image: prom/node-exporter:v1.12.1
    container_name: node-exporter
    restart: unless-stopped
    pid: host
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--path.rootfs=/rootfs'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev)($$|/)'
      - '--collector.textfile.directory=/textfile'
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - ./textfile:/textfile:ro
    networks:
      - monitoring
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.55.1
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - monitoring
  postgres-exporter:
    image: quay.io/prometheuscommunity/postgres-exporter:v0.20.1
    container_name: postgres-exporter
    restart: unless-stopped
    environment:
      DATA_SOURCE_NAME: "postgresql://n8n:${POSTGRES_PASSWORD}@postgres:5432/n8n?sslmode=disable"
    networks:
      - monitoring
      - n8n-net
  influxdb:
    image: influxdb:1.8.10
    container_name: influxdb
    restart: unless-stopped
    environment:
      INFLUXDB_DB: ntopng
      INFLUXDB_HTTP_AUTH_ENABLED: "true"
      INFLUXDB_ADMIN_USER: ${INFLUXDB_ADMIN_USER}
      INFLUXDB_ADMIN_PASSWORD: ${INFLUXDB_ADMIN_PASSWORD}
      INFLUXDB_USER: ${INFLUXDB_USER}
      INFLUXDB_USER_PASSWORD: ${INFLUXDB_USER_PASSWORD}
    volumes:
      - influxdb_data:/var/lib/influxdb
    ports:
      - "192.168.15.3:8086:8086"
    networks:
      - monitoring
volumes:
  prometheus_data:
  grafana_data:
  influxdb_data:
networks:
  monitoring:
  # Rede do n8n-stack, para o postgres-exporter alcançar o banco.
  # O nome real e injetado pelo setup no arquivo .env (N8N_NETWORK).
  n8n-net:
    external: true
    name: ${N8N_NETWORK}
