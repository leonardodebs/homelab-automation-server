# =====================================================
# Modelo de configuração. Copie para .env e preencha.
#   cp .env.example .env
# Gere segredos fortes, por exemplo:
#   openssl rand -base64 24   (senha do Postgres)
#   openssl rand -hex 24      (chave do n8n)
# =====================================================

# PostgreSQL
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=n8n

# n8n
N8N_HOST=192.168.100.3
N8N_ENCRYPTION_KEY=troque_por_uma_chave_de_32_caracteres_ou_mais
